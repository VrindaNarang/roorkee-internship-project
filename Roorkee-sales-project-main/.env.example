# Copy this file to .env and adjust values as needed.
# .env is gitignored and must never be committed.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=salespilot
POSTGRES_PASSWORD=salespilot_dev_password
POSTGRES_DB=salespilot
POSTGRES_HOST=127.0.0.1
# 5433 on the host by default to avoid clashing with a locally-installed Postgres on 5432.
POSTGRES_PORT=5433

# Used by the backend directly. When running via Docker Compose, POSTGRES_HOST
# is overridden to "postgres" (the service name) automatically.
# NOTE: 127.0.0.1, not "localhost" — avoids an intermittently flaky IPv6/WSL2
# relay path on Docker Desktop. See the root .env for the full explanation.
DATABASE_URL=postgresql+psycopg2://salespilot:salespilot_dev_password@127.0.0.1:5433/salespilot

# --- Backend ---
API_V1_PREFIX=/api/v1
PROJECT_NAME=SalesPilot AI
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Where the backend looks for `ml/prediction/predict.py`'s SHAP plot PNGs.
# Leave blank for local dev (derived automatically from the repo layout —
# see `app/core/config.py`). Set explicitly in containerized deployments
# (docker-compose.prod.yml sets this to /ml-artifacts/prediction/plots,
# matching where it mounts the ml/artifacts volume).
PLOTS_DIR=

# --- Auth (Milestone 11) ---
# REQUIRED in any real deployment — the default below is for local dev only
# and must never be used in production. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Frontend (Vite reads VITE_ prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Sales Copilot LLM provider (Milestone 10) ---
# Free OpenAI-compatible providers only — no Claude, no OpenAI's own hosted API.
# Auto-selected in this order: Groq (if GROQ_API_KEY set) -> OpenRouter (if
# OPENROUTER_API_KEY set) -> Ollama (local, no key needed, final fallback).
# Set COPILOT_LLM_PROVIDER to force one explicitly ("groq" | "openrouter" | "ollama").
COPILOT_LLM_PROVIDER=

# Groq (preferred) — free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (2nd choice) — free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (local fallback) — run `ollama serve` + `ollama pull llama3.2` first
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
